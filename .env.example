# agent-proxy 环境配置模板：复制为 .env 后按环境修改
# .env 不入库（见 .gitignore）

# 监听与对外地址
AGENT_PROXY_LISTEN=0.0.0.0:8800
EXTERNAL_BASE=http://127.0.0.1:8800             # 对外域名，用于拼 proxy_url（部署时换成真实域名）
ENV=dev                                         # prod 下禁止 stub 校验/登录实现启动（改 prod 前先换实现）

# 身份与登录
TOKEN_VERIFY_IMPL=stub                          # stub | third_party（第三方校验接口，协议实现时定）
LOGIN_IMPL=stub                                 # stub | company_sso（公司统一登录，协议实现时定）
ADMIN_ROLE=admin

# 存储
MYSQL_DSN=mysql+aiomysql://root:123456@127.0.0.1:3306/agent_proxy   # 本地开发默认，部署时按环境修改
REDIS_URL=redis://127.0.0.1:6379/1
CACHE_TTL=300

# 上游
UPSTREAM_CONNECT_TIMEOUT=10
UPSTREAM_READ_TIMEOUT=60
UPSTREAM_MAX_REDIRECTS=3
UPSTREAM_MAX_CONNECTIONS=200
SHUTDOWN_DRAIN_SECONDS=10
MAX_BODY_SIZE=10MB
SSRF_ALLOW_PRIVATE=false                        # 仅联调环境放开内网上游

# 跨域（管理域，逗号分隔；空=不开）
CORS_ALLOWED_ORIGINS=

# OAuth（M6）
OAUTH_STATE_TTL=600
ADMIN_SESSION_TTL=28800

# 加密（ENCRYPT_AT_REST=on 时 MASTER_KEY 必填；OAuth 凭证始终强制加密）
ENCRYPT_AT_REST=false
MASTER_KEY=

# 日志与追踪
LOG_DIR=logs
LOG_LEVEL=INFO
TRACE_MODE=metadata                             # off | metadata | body（body 仅排障期临时开启）
TRACE_BODY_MAX_SIZE=64KB
